# Timely Router API 키 (서버 전용, 클라이언트로 노출되지 않음)
TIMELY_API_KEY=tk_xxx

# 대화 통역: 음성 인식 Groq(기본)·Gemini(예비), 번역 예비 경로 Anthropic 직접 키 (모두 서버 전용)
GROQ_API_KEY=gsk_xxx
GEMINI_API_KEY=AIza_xxx
ANTHROPIC_API_KEY=sk-ant-xxx

# Upstage OCR 키 (서버 전용). 없으면 이미지를 직접 보는 폴백만 돈다
UPSTAGE_API_KEY=up_xxx

# 초대 코드 목록 (쉼표 구분). 배포 환경에서 비어 있으면 모든 요청을 거부한다.
ACCESS_CODES=sakura-2026,kohaku-2026

# (선택) 메뉴 설명 캐시·진단 저장. Vercel Storage 에서 Redis(Redis Cloud)를 추가하면 자동 등록된다. 없으면 캐시 없이 동작.
# REDIS_URL=redis://default:password@host:port

# (선택) 진단용으로 최근 스캔 20건(사진·OCR·결과)을 Redis 에 7일 보관(밀려나면 삭제). 혼자 테스트하는 동안만 1 로.
# DEBUG_STORE=0
