# ── LLM (번역·설명·챗·아이콘·대화 통역) ───────────────────────────────────────
# 제공자는 LLM_PROVIDER 로 고른다: anthropic | timely | openai | upstage | openrouter
# 비워 두면 키가 있는 순서대로 timely → anthropic → openai → upstage 를 쓴다.
# 권장: Anthropic 키 하나(Claude Sonnet, 이미지 입력 가능). 비용을 더 줄이려면 UPSTAGE_API_KEY 하나로 OCR + Solar(글자만) 구성도 된다.
LLM_PROVIDER=anthropic

# 제공자별 키(쓰는 것만 채운다). 모두 서버 전용, 클라이언트로 노출되지 않는다
ANTHROPIC_API_KEY=sk-ant-xxx
# TIMELY_API_KEY=tk_xxx
# OPENAI_API_KEY=sk-xxx
# OPENROUTER_API_KEY=sk-or-xxx            # Anthropic 호환 경로. LLM_MODEL 필수(예: anthropic/claude-sonnet-5.5). 미검증

# (선택) 덮어쓰기. 비워 두면 제공자 기본값(anthropic/timely: claude-sonnet-5-5, openai: gpt-5.4-mini, upstage: solar-pro4)
# LLM_MODEL=
# LLM_ICON_MODEL=                         # 아이콘 생성용 상위 모델(기본: Claude 계열은 claude-opus-5-5, 그 외 기본 모델)
# LLM_API_KEY=                            # 제공자 키 대신 쓸 키
# LLM_BASE_URL=                           # 제공자 주소 대신 쓸 주소(Anthropic 호환·OpenAI 호환 프록시)

# ── OCR ──────────────────────────────────────────────────────────────────────
# Upstage Document OCR 키(서버 전용). 없으면 이미지를 직접 보는 폴백만 돈다(글자만 받는 모델이면 분석 불가)
UPSTAGE_API_KEY=up_xxx

# ── 대화 통역 음성 인식: Groq(기본)·Gemini(예비). 둘 다 무료 등급으로 충분 ─────────
GROQ_API_KEY=gsk_xxx
GEMINI_API_KEY=AIza_xxx

# ── 접근 ─────────────────────────────────────────────────────────────────────
# 초대 코드 목록(쉼표 구분). 배포 환경에서 비어 있으면 모든 요청을 거부한다. 로컬에서 비워 두면 모두 통과
ACCESS_CODES=sakura-2026,kohaku-2026

# ── 선택 ─────────────────────────────────────────────────────────────────────
# 메뉴 설명 캐시·진단 저장. Vercel Storage 에서 Redis(Redis Cloud)를 추가하면 자동 등록된다. 없으면 캐시 없이 동작.
# REDIS_URL=redis://default:password@host:port
# 진단용으로 최근 스캔 20건(사진·OCR·결과)을 Redis 에 7일 보관(밀려나면 삭제). 혼자 테스트하는 동안만 1 로.
# DEBUG_STORE=0
